{
  "name": "pi-extension-wt",
  "version": "0.3.1",
  "description": "Pi extension that switches pi session to git worktree (like cd but for worktrees)",
  "main": "index.ts",
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "store.ts",
    "history.ts",
    "sort.ts",
    "picker.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-extension",
    "pi-package",
    "pi",
    "worktree",
    "git",
    "session",
    "cd"
  ],
  "author": "buihongduc132",
  "license": "MIT",
  "homepage": "https://github.com/buihongduc132/pi-extension-wt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buihongduc132/pi-extension-wt.git"
  },
  "bugs": {
    "url": "https://github.com/buihongduc132/pi-extension-wt/issues"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "pi-kit": "github:buihongduc132/pi-kit#v0.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
