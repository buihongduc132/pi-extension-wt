{
  "name": "pi-extension-wt",
  "version": "0.1.0",
  "description": "Pi extension that switches pi session to git worktree (like cd but for worktrees)",
  "main": "index.ts",
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi-extension",
    "worktree",
    "git"
  ],
  "author": "buihongduc132",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@vitest/coverage-v8": "^1.6.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
